---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Page not found" description="This page could not be found. Return home or explore Martin Tahli's work." noindex>
  <div class="container page-intro"><p class="eyebrow">Page not found</p><h1>404.</h1><p class="lede">There is no page at this address.</p><div class="actions"><a class="button" href={withBase('/', base)}>Back Home</a><a class="button secondary" href={withBase('/work/', base)}>View Work</a></div></div>
</BaseLayout>
