---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { getPublishedNotes, getPublishedProjects } from '../../utils/content';
import { formatDate, readingMinutes } from '../../utils/publication';
import { withBase } from '../../utils/paths';
export const getStaticPaths = (async () => {
  const notes = await getPublishedNotes();
  return notes.map((note) => ({ params: { slug: note.data.slug }, props: { note } }));
}) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { note } = Astro.props;
const { data } = note;
const { Content, headings } = await render(note);
const relatedProjects = (await getPublishedProjects()).filter(({ data: project }) => project.caseStudyAvailable && data.relatedProjects.includes(project.slug));
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={data.title} description={data.description} type="article">
  <div class="container">
    <header class="page-intro"><a class="text-link" href={withBase('/notes/', base)}>← All notes</a><p class="eyebrow">{data.category}</p><h1>{data.title}</h1><p class="lede">{data.description}</p><div class="meta article-meta"><time datetime={data.date.toISOString()}>{formatDate(data.date)}</time><span>{readingMinutes(note.body ?? '')} min read</span>{data.updated && data.updated.getTime() !== data.date.getTime() && <span>Updated <time datetime={data.updated.toISOString()}>{formatDate(data.updated)}</time></span>}</div>{data.tags.length > 0 && <p class="meta article-meta">{data.tags.slice(0, 5).join(' / ')}</p>}</header>
    {data.heroImage && <figure class="article-media"><Image src={data.heroImage} alt={data.heroAlt ?? ''} widths={[640, 960, 1280]} sizes="(min-width: 82rem) 75rem, 100vw" loading="eager" format="webp" />{data.heroCaption && <figcaption>{data.heroCaption}</figcaption>}</figure>}
    <div class="reading-layout"><div class="reading-aside"><TableOfContents headings={headings} /></div><article class="prose"><Content />{relatedProjects.length > 0 && <aside class="article-close" aria-label="Related projects"><h2>Related work</h2>{relatedProjects.map(({ data: project }) => <p><a class="text-link" href={withBase(`/work/${project.slug}/`, base)}>{project.title} →</a></p>)}</aside>}<footer class="article-close"><a class="text-link" href={withBase('/notes/', base)}>← Back to notes</a></footer></article></div>
  </div>
</BaseLayout>
<style>.article-meta { margin-top: 1.25rem; }.page-intro > .eyebrow { margin-top: 1.5rem; }</style>
