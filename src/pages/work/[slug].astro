---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ProjectLinks from '../../components/ProjectLinks.astro';
import { getPublishedProjects } from '../../utils/content';
import { withBase } from '../../utils/paths';
export const getStaticPaths = (async () => {
  const projects = (await getPublishedProjects()).filter(({ data }) => data.caseStudyAvailable);
  return projects.map((project) => ({ params: { slug: project.data.slug }, props: { project } }));
}) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { project } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={data.title} description={data.description} type="article">
  <div class="container">
    <header class="page-intro"><a class="text-link" href={withBase('/work/', base)}>← All work</a><h1>{data.title}</h1><p class="lede">{data.summary}</p><dl class="project-facts">{data.role && <div><dt>Role</dt><dd>{data.role}</dd></div>}{data.year && <div><dt>Year</dt><dd>{data.year}</dd></div>}{data.visibility && <div><dt>Source</dt><dd>{data.visibility === 'private' ? 'Private source' : 'Public source'}</dd></div>}{data.status && <div><dt>Status</dt><dd>{data.status === 'in-progress' ? 'In progress' : data.status === 'live' ? 'Live' : 'Archived'}</dd></div>}</dl><ProjectLinks data={data} /></header>
    {data.heroImage && <figure class="article-media"><Image src={data.heroImage} alt={data.heroAlt ?? ''} widths={[640, 960, 1280]} sizes="(min-width: 82rem) 75rem, 100vw" loading="eager" format="webp" />{data.heroCaption && <figcaption>{data.heroCaption}</figcaption>}</figure>}
    <div class="reading-layout"><div class="reading-aside"><TableOfContents headings={headings} /></div><article class="prose"><Content /><footer class="article-close"><a class="text-link" href={withBase('/work/', base)}>← Back to work</a></footer></article></div>
  </div>
</BaseLayout>
<style>
  .project-facts { display: flex; flex-wrap: wrap; gap: 2rem; margin-top: 2rem; }
  .project-facts dt { color: var(--text-secondary); font: 0.7rem/1.6 var(--font-mono); margin-bottom: 0.4rem; }
  .project-facts dd { font-size: 0.9rem; }
</style>
