---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ProjectLinks from '../../components/ProjectLinks.astro';
import { getPublishedProjects } from '../../utils/content';
import { withBase } from '../../utils/paths';
export const getStaticPaths = (async () => {
  const projects = (await getPublishedProjects()).filter(
    ({ data }) => data.caseStudyAvailable,
  );
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { project } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);
const base = import.meta.env.BASE_URL;
const imageWidths = data.heroImage
  ? [...new Set([390, 640, 960, data.heroImage.width])]
      .filter((width) => width <= data.heroImage!.width)
      .sort((a, b) => a - b)
  : [];
---

<BaseLayout title={data.title} description={data.description} type="article">
  <div class="container">
    <header class:list={['page-intro', { 'with-media': data.heroImage }]}>
      <a class="text-link back-link" href={withBase('/work/', base)}>
        ← All work
      </a>
      <div class="project-introduction">
        <div class="project-heading">
          <p class="eyebrow">Product case study</p>
          <h1>{data.title}</h1>
          <p class="lede">{data.summary}</p>
          <dl class="project-facts">
            {data.role && (
              <div>
                <dt>Role</dt>
                <dd>{data.role}</dd>
              </div>
            )}
            {data.year && (
              <div>
                <dt>Year</dt>
                <dd>{data.year}</dd>
              </div>
            )}
            {data.visibility && (
              <div>
                <dt>Source</dt>
                <dd>
                  {data.visibility === 'private'
                    ? 'Private source'
                    : 'Public source'}
                </dd>
              </div>
            )}
            {data.status && (
              <div>
                <dt>Status</dt>
                <dd>
                  {data.status === 'in-progress'
                    ? 'In progress'
                    : data.status === 'live'
                      ? 'Live'
                      : 'Archived'}
                </dd>
              </div>
            )}
          </dl>
          <ProjectLinks data={data} />
        </div>
        {data.heroImage && (
          <figure class="project-media">
            <div class="media-frame">
              <Image
                src={data.heroImage}
                alt={data.heroAlt ?? ''}
                widths={imageWidths}
                sizes="(min-width: 52rem) 52vw, 100vw"
                loading="eager"
                fetchpriority="high"
                format="webp"
              />
            </div>
            {data.heroCaption && <figcaption>{data.heroCaption}</figcaption>}
          </figure>
        )}
      </div>
    </header>
    <div class="reading-layout">
      <div class="reading-aside">
        <TableOfContents headings={headings} />
      </div>
      <article class="prose">
        <Content />
        <footer class="article-close">
          <a class="text-link" href={withBase('/work/', base)}>
            ← Back to work
          </a>
        </footer>
      </article>
    </div>
  </div>
</BaseLayout>
<style>
  .back-link {
    margin-bottom: 2.5rem;
  }
  .project-heading,
  .project-media {
    min-width: 0;
  }
  .with-media .project-introduction {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .project-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2rem;
    margin-top: 2rem;
  }
  .project-facts dt {
    color: var(--text-secondary);
    font: 0.7rem/1.6 var(--font-mono);
    margin-bottom: 0.4rem;
  }
  .project-facts dd {
    font-size: 0.9rem;
  }
  .media-frame {
    padding: clamp(0.75rem, 2vw, 1.5rem);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .media-frame :global(img) {
    width: 100%;
  }
  .project-media figcaption {
    max-width: 58ch;
  }
  @media (max-width: 52rem) {
    .with-media .project-introduction {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .back-link {
      margin-bottom: 1.5rem;
    }
  }
</style>
