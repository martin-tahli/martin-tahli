---
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingMinutes } from '../utils/publication';
import { withBase } from '../utils/paths';
interface Props { note: CollectionEntry<'notes'> }
const { note } = Astro.props;
---
<article class="note-row">
  <div class="note-meta"><p class="eyebrow">{note.data.category}</p><time datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time><span>{readingMinutes(note.body ?? '')} min read</span></div>
  <div><h3><a href={withBase(`/notes/${note.data.slug}/`, import.meta.env.BASE_URL)}>{note.data.title}</a></h3><p>{note.data.description}</p></div>
</article>
<style>
  .note-row { display: grid; grid-template-columns: minmax(10rem, 1fr) 3fr; gap: 3rem; padding-block: 2rem; border-bottom: 1px solid var(--border); }
  .note-meta { display: grid; align-content: start; gap: 0.35rem; font: 0.75rem/1.5 var(--font-mono); color: var(--text-secondary); }
  .note-row h3 { font-size: 1.25rem; line-height: 1.4; }
  .note-row h3 + p { margin-top: 0.75rem; color: var(--text-secondary); max-width: 64ch; }
  @media (max-width: 36rem) { .note-row { grid-template-columns: 1fr; gap: 1rem; }.note-meta { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; } }
</style>
