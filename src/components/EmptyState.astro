---
interface Props {
  heading?: 'h2' | 'h3';
  title: string;
  description: string;
  href?: string;
  linkLabel?: string;
}
const {
  heading: Heading = 'h3',
  title,
  description,
  href,
  linkLabel,
} = Astro.props;
---

<div class="empty-state">
  <Heading>{title}</Heading>
  <div>
    <p>{description}</p>
    {href && linkLabel && (
      <a class="text-link" href={href}>
        {linkLabel} <span aria-hidden="true">→</span>
      </a>
    )}
  </div>
</div>
