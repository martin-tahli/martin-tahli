---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import ProjectLinks from './ProjectLinks.astro';
import { withBase } from '../utils/paths';
interface Props {
  project: CollectionEntry<'projects'>;
  reverse?: boolean;
}
const { project, reverse = false } = Astro.props;
const { data } = project;
const statusLabels = {
  'in-progress': 'In progress',
  live: 'Live',
  archived: 'Archived',
};
---

<article
  class:list={['project-card', { reverse, 'text-led': !data.heroImage }]}
>
  {data.heroImage && (
    <figure>
      <Image
        src={data.heroImage}
        alt={data.heroAlt ?? ''}
        widths={[480, 800, 1200]}
        sizes="(min-width: 52rem) 50vw, 100vw"
        loading="lazy"
        format="webp"
      />
      {data.heroCaption && <figcaption>{data.heroCaption}</figcaption>}
    </figure>
  )}
  <div class="project-copy">
    <div class="meta">
      {data.year && <span>{data.year}</span>}
      {data.status && <span>{statusLabels[data.status]}</span>}
      {data.visibility && (
        <span>
          {data.visibility === 'private' ? 'Private source' : 'Public source'}
        </span>
      )}
    </div>
    <h3>{data.title}</h3>
    <p class="muted">{data.summary}</p>
    {data.role && <p class="project-role">{data.role}</p>}
    {data.technologies.length > 0 && (
      <ul class="project-tags" aria-label="Technologies">
        {data.technologies.slice(0, 4).map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    )}
    {data.caseStudyAvailable && (
      <a
        class="text-link"
        href={withBase(`/work/${data.slug}/`, import.meta.env.BASE_URL)}
      >
        View case study <span aria-hidden="true">→</span>
        <span class="sr-only">: {data.title}</span>
      </a>
    )}
    <ProjectLinks data={data} />
  </div>
</article>
<style>
  .project-card {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 3rem;
    align-items: center;
    padding-block: 2.5rem;
    border-bottom: 1px solid var(--border);
  }
  .project-card.text-led {
    display: block;
  }
  .project-card.reverse figure {
    order: 2;
  }
  figure :global(img) {
    width: 100%;
    border-radius: var(--radius);
  }
  h3 {
    font: 400 clamp(1.75rem, 3vw, 2.5rem)/1.12 var(--font-display);
    margin-block: 1rem;
  }
  .project-role {
    margin-top: 1rem;
    font-size: 0.875rem;
  }
  .project-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin-block: 1rem;
  }
  .project-tags li {
    font: 0.7rem/1.5 var(--font-mono);
    border: 1px solid var(--border);
    padding: 0.25rem 0.5rem;
    border-radius: 3px;
  }
  @media (max-width: 52rem) {
    .project-card {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .project-card.reverse figure {
      order: 0;
    }
  }
</style>
