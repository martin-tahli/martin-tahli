---
interface Props {
  number: string;
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
}
const { number, title, description, href, linkLabel } = Astro.props;
---

<div class="section-heading">
  <span class="eyebrow" aria-hidden="true">
    {number}.
  </span>
  <div>
    <h2>{title}</h2>
    {description && <p>{description}</p>}
  </div>
  {href && linkLabel && (
    <a class="text-link" href={href}>
      {linkLabel} <span aria-hidden="true">→</span>
    </a>
  )}
</div>
